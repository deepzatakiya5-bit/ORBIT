PORT=8081
POSTGRES_PORT=5434
DATABASE_URL=postgres://orbit:orbit@localhost:5434/orbit?sslmode=disable

# Required — use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=75568c72364c2b1ced372dc823edb57ffb00747

# LLM provider (recommended for free/local testing)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Optional Gemini fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional — enables long-term memory service integration
MEMORY_SERVICE_URL=http://localhost:8090
MEMORY_SERVICE_TOKEN=

# Set FE_DEV=1 when using `make fe` (static server on :3000)
FE_DEV=1
FE_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
